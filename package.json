{
  "name": "@your-org/nuxt-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "web-types": "./web-types.json",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint.oxlint": "oxlint --config=./oxlint.config.jsonc --deny-warnings --fix .",
    "lint.eslint": "eslint --cache --fix --max-warnings 0 --no-error-on-unmatched-pattern \"**/*.{js,ts,cjs,mjs,html,vue}\"",
    "lint.tsc": "vue-tsc --noEmit --project tsconfig.lint.json",
    "lint.stylelint": "stylelint --cache --max-warnings 0 --fix \"**/*.{css,vue}\"",
    "lint.prettier": "prettier --write --cache --ignore-unknown --no-error-on-unmatched-pattern --log-level warn .",
    "lint": "pnpm lint.oxlint && pnpm lint.eslint && pnpm lint.tsc && pnpm lint.stylelint && pnpm lint.prettier",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@nuxt/devtools": "3.1.1",
    "@nuxt/eslint": "1.11.0",
    "@nuxt/icon": "2.1.0",
    "@nuxt/image": "2.0.0",
    "@nuxtjs/color-mode": "4.0.0",
    "@pinia/nuxt": "0.11.3",
    "@primeuix/themes": "^2.0.1",
    "@primevue/core": "^4.5.0",
    "@primevue/forms": "^4.5.0",
    "@primevue/nuxt-module": "^4.5.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "4.1.17",
    "@vueuse/core": "^14.1.0",
    "@vueuse/nuxt": "14.1.0",
    "change-case": "^5.4.4",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "eslint": "^9.39.1",
    "nuxt": "4.2.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "4.1.17",
    "tailwindcss-primeui": "^0.6.1",
    "vite": "^7.2.6",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
    "@eslint/js": "^9.39.1",
    "@eslint/json": "^0.14.0",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.77",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@iconify-json/tabler": "^1.2.23",
    "@nuxt/schema": "^4.2.1",
    "@nuxt/types": "^2.18.1",
    "@types/node": "^24.10.1",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/language-server": "^3.1.5",
    "dotenv": "^17.2.3",
    "eslint-config-flat-gitignore": "^2.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-custom-alias": "^1.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-oxlint": "^1.31.0",
    "eslint-plugin-unicorn": "^62.0.0",
    "eslint-plugin-vue": "^10.6.2",
    "neostandard": "^0.12.2",
    "oxlint": "1.31.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^16.26.1",
    "stylelint-config-clean-order": "^8.0.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-standard-vue": "^1.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vue-component-type-helpers": "^3.1.5",
    "vue-tsc": "^3.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "simple-git-hooks",
      "unrs-resolver"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint"
  }
}
