{
  "name": "@your-org/nuxt-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "web-types": "./web-types.json",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint.oxlint": "oxlint --config=./oxlint.config.jsonc --deny-warnings --fix .",
    "lint.eslint": "eslint --cache --fix --max-warnings 0 --no-error-on-unmatched-pattern \"**/*.{js,ts,cjs,mjs,html,vue}\"",
    "lint.tsc": "vue-tsc --noEmit --project tsconfig.lint.json",
    "lint.stylelint": "stylelint --cache --max-warnings 0 --fix \"**/*.{css,vue}\"",
    "lint.prettier": "prettier --write --cache --ignore-unknown --no-error-on-unmatched-pattern --log-level warn .",
    "lint": "pnpm lint.oxlint && pnpm lint.eslint && pnpm lint.tsc && pnpm lint.stylelint && pnpm lint.prettier",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@nuxt/devtools": "3.2.4",
    "@nuxt/eslint": "1.15.2",
    "@nuxt/icon": "2.2.1",
    "@nuxt/image": "2.0.0",
    "@nuxtjs/color-mode": "4.0.0",
    "@pinia/nuxt": "0.11.3",
    "@primeuix/themes": "^2.0.3",
    "@primevue/core": "^4.5.4",
    "@primevue/forms": "^4.5.4",
    "@primevue/nuxt-module": "^4.5.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "4.2.2",
    "@vueuse/core": "^14.2.1",
    "@vueuse/nuxt": "14.2.1",
    "change-case": "^5.4.4",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "eslint": "^10.2.0",
    "nuxt": "4.4.2",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "4.2.2",
    "tailwindcss-primeui": "^0.6.1",
    "vite": "^8.0.7",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.101",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@iconify-json/tabler": "^1.2.33",
    "@nuxt/schema": "^4.4.2",
    "@nuxt/types": "^2.18.1",
    "@types/node": "^25.5.2",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/language-server": "^3.2.6",
    "dotenv": "^17.4.1",
    "eslint-config-flat-gitignore": "^2.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-custom-alias": "^1.3.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-oxlint": "^1.59.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-vue": "^10.8.0",
    "neostandard": "^0.13.0",
    "oxlint": "1.59.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.6.0",
    "stylelint-config-clean-order": "^8.0.1",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vue-component-type-helpers": "^3.2.6",
    "vue-tsc": "^3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "simple-git-hooks",
      "unrs-resolver"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint"
  }
}
